<Window x:Class="Cashier.UI.Views.PurchaseInvoiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="ar-EG"
        Title="تفاصيل فاتورة الشراء" Width="1120" Height="740"
        MinWidth="760" MinHeight="500" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="إغلاق" Click="CloseWindow_OnClick" DockPanel.Dock="Left" />
            <TextBlock Text="تفاصيل فاتورة الشراء" FontSize="23" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="1" Padding="14" Margin="0,0,0,10"
                Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
            <UniformGrid Columns="4">
                <StackPanel Margin="5"><TextBlock Text="رقم الفاتورة" Foreground="{DynamicResource SubtleBrush}" /><TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" /></StackPanel>
                <StackPanel Margin="5"><TextBlock Text="التاريخ" Foreground="{DynamicResource SubtleBrush}" /><TextBlock Text="{Binding CreatedAt, Converter={StaticResource EgyptDateTimeConverter}}" /></StackPanel>
                <StackPanel Margin="5"><TextBlock Text="المورد" Foreground="{DynamicResource SubtleBrush}" /><TextBlock Text="{Binding Supplier.Name}" /></StackPanel>
                <StackPanel Margin="5"><TextBlock Text="الحالة" Foreground="{DynamicResource SubtleBrush}" /><TextBlock Text="{Binding Status, Converter={StaticResource ArabicEnumConverter}}" /></StackPanel>
            </UniformGrid>
        </Border>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" MinHeight="0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="2*" />
                <DataGridTextColumn Header="رمز المنتج" Binding="{Binding Sku}" Width="*" />
                <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="*" />
                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="*" />
                <DataGridTextColumn Header="الخصم" Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}" Width="*" />
                <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="12"
                Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10">
            <UniformGrid Columns="4">
                <StackPanel Margin="5"><TextBlock Text="إجمالي الأصناف" Foreground="{DynamicResource SubtleBrush}" /><TextBlock Text="{Binding Subtotal, StringFormat={}{0:N2}}" /></StackPanel>
                <StackPanel Margin="5"><TextBlock Text="الخصم" Foreground="{DynamicResource SubtleBrush}" /><TextBlock Text="{Binding DiscountTotal, StringFormat={}{0:N2}}" /></StackPanel>
                <StackPanel Margin="5"><TextBlock Text="الإجمالي" Foreground="{DynamicResource SubtleBrush}" /><TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2}}" FontWeight="Bold" /></StackPanel>
                <StackPanel Margin="5"><TextBlock Text="المدفوع" Foreground="{DynamicResource SubtleBrush}" /><TextBlock Text="{Binding TotalPaid, StringFormat={}{0:N2}}" FontWeight="Bold" /></StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
