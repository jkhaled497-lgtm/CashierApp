<UserControl x:Class="Cashier.UI.Views.CashierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <DockPanel Margin="4,0,0,10">
                        <TextBlock Text="نقطة البيع" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Session.Username, StringFormat=مرحباً، {0}}"
                                   VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" DockPanel.Dock="Left" />
                    </DockPanel>
                    <ComboBox x:Name="ProductSearchBox" ItemsSource="{Binding Products}"
                              Tag="اختر المنتج أو ابحث بالاسم"
                              IsEditable="True" IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True" MaxDropDownHeight="220"
                              IsDropDownOpen="{Binding IsProductDropdownOpen, Mode=TwoWay}"
                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                              GotKeyboardFocus="ProductSearch_OnGotKeyboardFocus"
                              SelectionChanged="ProductSearch_OnSelectionChanged"
                              ToolTip="اضغط للبحث أو اختيار منتج، ثم اكتب للتصفية">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2">
                                    <Image Source="{Binding ImagePath, Converter={StaticResource ProductImageSourceConverter}}"
                                           Width="34" Height="34" Stretch="UniformToFill" Margin="0,0,6,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Foreground="{StaticResource SubtleBrush}" FontSize="11">
                                            <Run Text="المخزون " /><Run Text="{Binding CurrentStock, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding SellingPrice, Mode=OneWay, StringFormat={}{0:C2}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DockPanel/>
                </StackPanel>
                <Border Grid.Row="1" Padding="12" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="إجماليات الفاتورة" FontSize="18" FontWeight="SemiBold" Margin="3,0,3,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="الإجمالي قبل الخصم" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:C2}}" />
                                <TextBlock Grid.Row="1" Text="إجمالي الخصم" Foreground="{StaticResource SubtleBrush}" Margin="0,5" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountTotal, StringFormat={}{0:C2}}" Margin="0,5" />
                                <TextBlock Grid.Row="2" Text="التقريب" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Rounding, StringFormat={}{0:C2}}" />
                                <TextBlock Grid.Row="3" Text="الإجمالي" FontWeight="Bold" FontSize="17" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GrandTotal, StringFormat={}{0:C2}}"
                                           FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
                            </Grid>
                            <TextBlock Text="خصم الصنف المحدد (قيمة)" Style="{StaticResource EditorFieldLabel}" Margin="3,12,3,0" />
                            <TextBox Text="{Binding SelectedLine.DiscountAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                     IsEnabled="{Binding SelectedLine, Converter={StaticResource NotNullToBooleanConverter}}"
                                     ToolTip="قيمة الخصم النقدية للصنف المحدد" />
                            <TextBlock Text="طريقة الدفع والمبلغ" FontWeight="SemiBold" Margin="3,4" />
                            <TextBlock Text="طريقة الدفع" Style="{StaticResource EditorFieldLabel}" />
                            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                                      Tag="اختر طريقة الدفع" MinHeight="38" Margin="3">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ArabicEnumConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="المبلغ المدفوع" Style="{StaticResource EditorFieldLabel}" />
                            <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=0.00}"
                                     ToolTip="المبلغ المدفوع" />
                            <StackPanel Visibility="{Binding HasSelectedRegisteredCustomer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="المتبقي على العميل" Style="{StaticResource EditorFieldLabel}" />
                                <TextBox Text="{Binding RemainingAmount, Mode=OneWay, StringFormat=0.00}"
                                         IsReadOnly="True" IsEnabled="{Binding HasSelectedRegisteredCustomer}"
                                         ToolTip="المبلغ المتبقي على العميل" />
                            </StackPanel>
                            <Button Content="إتمام البيع" Command="{Binding CheckoutCommand}"
                                    Background="{DynamicResource AccentBrush}" Foreground="White"
                                    FontWeight="SemiBold" FontSize="16" Padding="18,9" Margin="3,12,3,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="2,0,2,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="بدون عميل" Command="{Binding ClearSelectedCustomerCommand}" />
                            <Button Content="عميل نقدي" Command="{Binding SelectWalkInCustomerCommand}" />
                            <Button Content="عميل مسجل" Command="{Binding SelectRegisteredCustomerCommand}" />
                            <Button Content="＋ إضافة عميل" Command="{Binding OpenQuickCustomerCommand}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                  Tag="اختر العميل"
                                  DisplayMemberPath="FullName" IsEditable="True" IsTextSearchEnabled="True"
                                  Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}"
                                  IsDropDownOpen="{Binding IsCustomerPickerOpen, Mode=TwoWay}"
                                  MinHeight="36" Margin="3" ToolTip="اختر عميلاً أو اكتب للبحث" />
                    </DockPanel>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" AlternatingRowBackground="{DynamicResource GridAlternateBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" IsReadOnly="True" Width="75" />
                        <DataGridTemplateColumn Header="الكمية" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="−" Padding="5,2" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}"
                                                 Width="44" MinHeight="28" Padding="3" VerticalContentAlignment="Center" />
                                        <Button Content="＋" Padding="5,2" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:C2}}" IsReadOnly="True" Width="84" />
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="×" Padding="6,2" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AlertBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ChangeDue, StringFormat=الباقي: {0:C2}}" Foreground="{DynamicResource AlertBrush}"
                           FontWeight="SemiBold" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
        <Border Grid.RowSpan="2" Background="#99000000" Visibility="{Binding ShowQuickCustomer, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="215,382,-417,-382" Grid.Column="1">
            <Border Width="470" Padding="24" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة عميل سريعاً" FontSize="20" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="اسم العميل (اختياري)" Style="{StaticResource EditorFieldLabel}" />
                            <TextBox Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="رقم الهاتف" Style="{StaticResource EditorFieldLabel}" />
                            <TextBox Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,10,0,0">
                        <Button Content="إلغاء" Command="{Binding OpenQuickCustomerCommand}" />
                        <Button Content="حفظ العميل" Command="{Binding CreateQuickCustomerCommand}" Background="{DynamicResource AccentBrush}"
                                Foreground="White" DockPanel.Dock="Right" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
