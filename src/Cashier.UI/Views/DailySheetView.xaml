<UserControl x:Class="Cashier.UI.Views.DailySheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="14" Margin="0,0,0,10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="تاريخ الشيت" VerticalAlignment="Center" Margin="4" FontWeight="SemiBold" />
                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="155" />
                    <Button Content="تحديث الشيت" Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="الشيت اليومي" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="مبيعات المحل وحركات المخزن والعملاء والموردين"
                               Foreground="{DynamicResource SubtleBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl Grid.Row="1">
            <TabItem Header="منتجات المحل">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="10" Margin="0,0,0,8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="المنتج" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="270" Margin="3" ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding SelectedProduct}" ToolTip="اختر المنتج المباع من المحل">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Foreground="{DynamicResource SubtleBrush}" FontSize="11">
                                                <Run Text="كمية المحل: " /><Run Text="{Binding CurrentStock, StringFormat={}{0:0.###}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="الكمية المباعة" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="110" Margin="3" Text="{Binding SaleQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="الكمية المباعة" />
                            <TextBlock Text="الإجمالي" VerticalAlignment="Center" Margin="4" />
                            <TextBlock Text="{Binding SaleTotal, StringFormat={}{0:N2}}" VerticalAlignment="Center" Margin="3" />
                            <TextBlock Text="المدفوع (فارغ = كامل)" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="110" Margin="3" Text="{Binding SaleAmountPaid, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="المبلغ المحصل؛ اتركه فارغاً لتحصيل كامل قيمة البيع" />
                            <TextBlock Text="طريقة التحصيل" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="135" Margin="3" ItemsSource="{Binding PaymentMethods}"
                                      SelectedItem="{Binding SalePaymentMethod}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ArabicEnumConverter}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="المتبقي" VerticalAlignment="Center" Margin="4" />
                            <TextBlock Text="{Binding SaleRemaining, StringFormat={}{0:N2}}" VerticalAlignment="Center" Margin="3" />
                            <TextBlock Text="العميل (اختياري)" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="240" Margin="3" ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SaleCustomer}" DisplayMemberPath="FullName"
                                      ToolTip="العميل اختياري" />
                            <Button Content="تسجيل البيع وخصم الكمية" Command="{Binding AddDailyProductCommand}"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" />
                        </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DailyProducts}" SelectedItem="{Binding SelectedDailyProduct}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="40" ColumnHeaderHeight="38" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="وقت التسجيل" Binding="{Binding CreatedAt, Converter={StaticResource EgyptDateTimeConverter}}" Width="180" />
                            <DataGridTextColumn Header="رمز المنتج" Binding="{Binding Sku}" Width="150" />
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="140" />
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120" />
                            <DataGridTextColumn Header="المدفوع" Binding="{Binding AmountPaid, StringFormat={}{0:N2}}" Width="120" />
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat={}{0:N2}}" Width="120" />
                            <DataGridTextColumn Header="طريقة التحصيل" Binding="{Binding PaymentMethod, Converter={StaticResource ArabicEnumConverter}}" Width="130" />
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer.FullName, TargetNullValue=بيع عام}" Width="180" />
                            <DataGridTextColumn Header="المستخدم" Binding="{Binding User.Username}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="تعديل الحركة المحددة:" VerticalAlignment="Center" Margin="4" />
                            <TextBlock Text="الكمية الجديدة" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="110" Margin="3" Text="{Binding EditedSaleQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="الكمية الجديدة" />
                            <TextBlock Text="الإجمالي" VerticalAlignment="Center" Margin="4" />
                            <TextBlock Text="{Binding EditedSaleTotal, StringFormat={}{0:N2}}" VerticalAlignment="Center" Margin="3" />
                            <TextBlock Text="المدفوع" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="110" Margin="3" Text="{Binding EditedSaleAmountPaid, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="المبلغ المحصل" />
                            <TextBlock Text="المتبقي" VerticalAlignment="Center" Margin="4" />
                            <TextBlock Text="{Binding EditedSaleRemaining, StringFormat={}{0:N2}}" VerticalAlignment="Center" Margin="3" />
                            <ComboBox Width="135" Margin="3" ItemsSource="{Binding PaymentMethods}"
                                      SelectedItem="{Binding EditedSalePaymentMethod}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ArabicEnumConverter}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="العميل (اختياري)" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="220" Margin="3" ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding EditedSaleCustomer}" DisplayMemberPath="FullName"
                                      ToolTip="العميل اختياري" />
                            <Button Content="حفظ التعديل" Command="{Binding UpdateDailyProductCommand}"
                                    IsEnabled="{Binding SelectedDailyProduct, Converter={StaticResource NotNullToBooleanConverter}}" />
                            <TextBlock Text="سيتم تحديث رصيد المحل تلقائياً." VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleBrush}" Margin="8,0" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="حركات المخزن">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="10" Margin="0,0,0,8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10"
                            IsEnabled="{Binding CanManageWarehouse}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="المنتج" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="255" Margin="3" ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding WarehouseProduct}" ToolTip="اختر المنتج">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Foreground="{DynamicResource SubtleBrush}" FontSize="11">
                                                <Run Text="كمية المخزن: " /><Run Text="{Binding WarehouseStock, StringFormat={}{0:0.###}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="نوع الحركة" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="190" Margin="3" ItemsSource="{Binding WarehouseMovementTypes}"
                                      SelectedItem="{Binding WarehouseMovementType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ArabicEnumConverter}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="الكمية" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="105" Margin="3" Text="{Binding WarehouseQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="الكمية" />
                            <TextBlock Text="السبب أو الملاحظات" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="200" Margin="3" Text="{Binding WarehouseReason, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="السبب أو الملاحظات" />
                            <Button Content="تسجيل حركة المخزن" Command="{Binding AddWarehouseMovementCommand}"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" />
                        </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WarehouseMovements}"
                              SelectedItem="{Binding SelectedWarehouseMovement}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="40" ColumnHeaderHeight="38" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, Converter={StaticResource EgyptDateTimeConverter}}" Width="180" />
                            <DataGridTextColumn Header="المنتج" Binding="{Binding Product.Name}" Width="*" />
                            <DataGridTextColumn Header="نوع الحركة" Binding="{Binding Type, Converter={StaticResource ArabicEnumConverter}}" Width="190" />
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="110" />
                            <DataGridTextColumn Header="رصيد المخزن الحالي" Binding="{Binding Product.WarehouseStock, StringFormat={}{0:0.###}}" Width="155" />
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="150" />
                            <DataGridTextColumn Header="السبب/مصدر الحركة" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8"
                            IsEnabled="{Binding CanManageWarehouse}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="تعديل الحركة المحددة:" VerticalAlignment="Center" Margin="4" />
                            <TextBlock Text="الكمية الجديدة" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="110" Margin="3" Text="{Binding EditedWarehouseQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="الكمية الجديدة" />
                            <TextBlock Text="السبب أو المصدر" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="250" Margin="3" Text="{Binding EditedWarehouseReason, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="السبب أو المصدر" />
                            <Button Content="حفظ التعديل" Command="{Binding UpdateWarehouseMovementCommand}"
                                    IsEnabled="{Binding SelectedWarehouseMovement, Converter={StaticResource NotNullToBooleanConverter}}" />
                            <TextBlock Text="تتغير أرصدة المخزن والمحل حسب فرق الكمية." VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleBrush}" Margin="8,0" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="العملاء">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="10" Margin="0,0,0,8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="العميل" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="240" Margin="3" ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="FullName"
                                      ToolTip="اختر العميل" />
                            <TextBlock Text="المبلغ" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="120" Margin="3" Text="{Binding AccountAmount, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="المبلغ" />
                            <TextBlock Text="طريقة الدفع" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="165" Margin="3" ItemsSource="{Binding PaymentMethods}"
                                      SelectedItem="{Binding AccountPaymentMethod}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ArabicEnumConverter}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="ملاحظات" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="220" Margin="3" Text="{Binding AccountNote, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="ملاحظات" />
                            <Button Content="إضافة استحقاق" Command="{Binding AddCustomerChargeCommand}" />
                            <Button Content="تسجيل سداد" Command="{Binding PayCustomerBalanceCommand}" />
                        </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CustomerMovements}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="40" ColumnHeaderHeight="38" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, Converter={StaticResource EgyptDateTimeConverter}}" Width="180" />
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer.FullName}" Width="*" />
                            <DataGridTextColumn Header="نوع الحركة" Binding="{Binding Type, Converter={StaticResource ArabicEnumConverter}}" Width="175" />
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130" />
                            <DataGridTextColumn Header="الرصيد بعد الحركة" Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}" Width="150" />
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding Invoice.InvoiceNumber, TargetNullValue=—}" Width="170" />
                            <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="الموردون" IsEnabled="{Binding CanManageSupplierAccounts}">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="10" Margin="0,0,0,8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="المورد" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="240" Margin="3" ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name"
                                      ToolTip="اختر المورد" />
                            <TextBlock Text="المبلغ" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="120" Margin="3" Text="{Binding AccountAmount, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="المبلغ" />
                            <TextBlock Text="طريقة الدفع" VerticalAlignment="Center" Margin="4" />
                            <ComboBox Width="165" Margin="3" ItemsSource="{Binding PaymentMethods}"
                                      SelectedItem="{Binding AccountPaymentMethod}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ArabicEnumConverter}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="ملاحظات" VerticalAlignment="Center" Margin="4" />
                            <TextBox Width="220" Margin="3" Text="{Binding AccountNote, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="ملاحظات" />
                            <Button Content="إضافة استحقاق" Command="{Binding AddSupplierChargeCommand}" />
                            <Button Content="تسجيل سداد" Command="{Binding PaySupplierBalanceCommand}" />
                        </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SupplierMovements}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="40" ColumnHeaderHeight="38" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, Converter={StaticResource EgyptDateTimeConverter}}" Width="180" />
                            <DataGridTextColumn Header="المورد" Binding="{Binding Supplier.Name}" Width="*" />
                            <DataGridTextColumn Header="نوع الحركة" Binding="{Binding Type, Converter={StaticResource ArabicEnumConverter}}" Width="175" />
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130" />
                            <DataGridTextColumn Header="الرصيد بعد الحركة" Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}" Width="150" />
                            <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*" />
                            <DataGridTextColumn Header="المستخدم" Binding="{Binding User.Username}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="9" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AlertBrush}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
