<UserControl x:Class="Cashier.UI.Views.PurchaseEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cashier.UI.Controls">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="16" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="إنشاء فاتورة شراء" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="اختر المورد وأضف المنتجات والكميات والأسعار والخصومات، ثم سجل المبلغ المدفوع."
                               Foreground="{DynamicResource SubtleBrush}" Margin="0,4,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="المورد" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="320" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="حفظ فاتورة الشراء" Command="{Binding SaveCommand}"
                        VerticalAlignment="Center" Padding="18,11"
                        Background="{DynamicResource AccentBrush}" Foreground="White" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="12"
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <ComboBox Width="350" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                      DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Name" ToolTip="اختر منتجاً أو اكتب اسمه للبحث" />
                            <Button Content="إضافة إلى الفاتورة" Command="{Binding AddItemCommand}"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" />
                        </StackPanel>
                        <Button Content="إضافة منتج جديد" Command="{Binding CreateProductCommand}"
                                DockPanel.Dock="Right" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionMode="Single" MinHeight="0"
                              HeadersVisibility="Column" RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                                Width="125" />
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                Width="100" />
                            <DataGridTextColumn Header="الخصم (جنيه)" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                                Width="130" />
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:N2}}"
                                                IsReadOnly="True" Width="120" />
                            <DataGridTemplateColumn Header="حذف" Width="68">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="حذف"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="5,3" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="16"
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" controls:ScrollNavigation.IsEnabled="True">
                    <StackPanel>
                        <TextBlock Text="ملخص الفاتورة" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="إجمالي الأصناف" Foreground="{DynamicResource SubtleBrush}" />
                        <TextBlock Text="{Binding Subtotal, StringFormat={}{0:N2}}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,10" />
                        <TextBlock Text="إجمالي الخصم" Foreground="{DynamicResource SubtleBrush}" />
                        <TextBlock Text="{Binding DiscountTotal, StringFormat={}{0:N2}}" FontSize="18" Margin="0,2,0,10" />
                        <Separator Margin="0,4,0,10" />
                        <TextBlock Text="الإجمالي المستحق" Foreground="{DynamicResource SubtleBrush}" />
                        <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,14" />
                        <TextBlock Text="طريقة الدفع" Foreground="{DynamicResource SubtleBrush}" />
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Margin="0,4,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ArabicEnumConverter}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="المبلغ المدفوع (يمكن دفع جزء من الفاتورة)" Foreground="{DynamicResource SubtleBrush}" />
                        <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <TextBlock Text="المتبقي للمورد" Foreground="{DynamicResource SubtleBrush}" />
                        <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N2}}" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource AlertBrush}" Margin="4,9,4,0"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
