<UserControl x:Class="Cashier.UI.Views.InvoiceLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cashier.UI.Controls"
             Loaded="OnLoaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="16" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="الفواتير" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="ابحث برقم الفاتورة أو اسم العميل أو رقم الهاتف، ثم اختر الفاتورة لعرض تفاصيلها."
                               Foreground="{DynamicResource SubtleBrush}" Margin="0,4,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="رقم الفاتورة أو العميل أو الهاتف" VerticalAlignment="Center" Margin="4" />
                        <TextBox Width="320" MaxLength="80"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="رقم الفاتورة أو اسم العميل أو الهاتف"
                                 VerticalContentAlignment="Center" TextChanged="TextBox_TextChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="بحث" Command="{Binding SearchCommand}"
                                Background="{DynamicResource AccentBrush}" Foreground="White" />
                        <StackPanel Margin="4,0">
                            <TextBlock Text="من تاريخ" Foreground="{DynamicResource SubtleBrush}" />
                            <DatePicker SelectedDate="{Binding FromDate}" Width="150" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="إلى تاريخ" Foreground="{DynamicResource SubtleBrush}" />
                            <DatePicker SelectedDate="{Binding ToDate}" Width="150" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="طباعة الفاتورة" Command="{Binding PrintCommand}"
                        IsEnabled="{Binding HasResult}"
                        VerticalAlignment="Center" Margin="16,0,0,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" MinWidth="330" />
                <ColumnDefinition Width="1.5*" MinWidth="420" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12" Margin="0,0,8,0"
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="سجل الفواتير" FontSize="17" FontWeight="SemiBold" Margin="4,0,4,8" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding InvoiceRows}"
                              SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MinHeight="0"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="105" />
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, Converter={StaticResource EgyptDateTimeConverter}}" Width="180" />
                            <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="2,10,2,0">
                        <TextBlock Text="{Binding Pager.Summary}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="السابق" Command="{Binding Pager.PreviousPageCommand}" />
                            <Button Content="التالي" Command="{Binding Pager.NextPageCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="16" Margin="8,0,0,0"
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              controls:ScrollNavigation.IsEnabled="True">
                    <StackPanel>
                        <TextBlock Text="تفاصيل الفاتورة" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="اختر فاتورة من السجل لعرض بياناتها ومنتجاتها ومدفوعاتها."
                                   Foreground="{DynamicResource SubtleBrush}"
                                   Visibility="{Binding HasResult, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="5">
                                    <TextBlock Text="رقم الفاتورة" Foreground="{DynamicResource SubtleBrush}" />
                                    <TextBlock Text="{Binding Result.InvoiceNumber}" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="التاريخ" Foreground="{DynamicResource SubtleBrush}" />
                                    <TextBlock Text="{Binding Result.CreatedAt, Converter={StaticResource EgyptDateTimeConverter}}" />
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="العميل" Foreground="{DynamicResource SubtleBrush}" />
                                    <TextBlock Text="{Binding Result.Customer.FullName, TargetNullValue=بدون عميل}" />
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="المستخدم" Foreground="{DynamicResource SubtleBrush}" />
                                    <TextBlock Text="{Binding Result.CreatedByUser.Username, TargetNullValue=غير متاح}" />
                                </StackPanel>
                            </UniformGrid>
                            <Button Content="عرض منتجات الفاتورة" Click="ShowInvoiceItems_OnClick"
                                    HorizontalAlignment="Right" Margin="5,8"
                                    IsEnabled="{Binding HasResult}"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" />
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <TextBlock Text="{Binding Result.Subtotal, StringFormat=المجموع: {0:N2}}" FontWeight="SemiBold" Margin="5" />
                                <TextBlock Text="{Binding Result.DiscountTotal, StringFormat=الخصم: {0:N2}}" FontWeight="SemiBold" Margin="5" />
                                <TextBlock Text="{Binding Result.TotalPaid, StringFormat=المدفوع: {0:N2}}" FontWeight="SemiBold" Margin="5" />
                                <TextBlock Text="{Binding Result.GrandTotal, StringFormat=الإجمالي: {0:N2}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="5" />
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource AlertBrush}"
                   Margin="4,8,4,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
