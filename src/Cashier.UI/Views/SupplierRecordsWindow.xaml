<Window x:Class="Cashier.UI.Views.SupplierRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Cashier.UI.Views"
        xml:lang="ar-EG"
        Title="بيانات المورد" Width="1240" Height="760" MinWidth="820" MinHeight="520"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="16" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Selected.Name, TargetNullValue=بيانات المورد}"
                               FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Selected.Phone, StringFormat=الهاتف: {0}}"
                               Foreground="{DynamicResource SubtleBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="المبلغ المستحق للمورد"
                               Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding Selected.CurrentBalance, StringFormat={}{0:N2}}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="إغلاق" Click="CloseWindow_OnClick"
                        VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>
        </Border>

        <TabControl x:Name="RecordsTabs" Grid.Row="1" FlowDirection="RightToLeft">
            <TabItem Header="كشف حساب المورد">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" Style="{StaticResource AccountStatementGrid}"
                              ItemsSource="{Binding Ledger}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionUnit="FullRow" MinHeight="0" RowHeight="44"
                              ColumnHeaderHeight="42" VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ"
                                                Binding="{Binding CreatedAt, Converter={StaticResource EgyptDateTimeConverter}}"
                                                Width="170" />
                            <DataGridTextColumn Header="نوع الحركة"
                                                Binding="{Binding Type, Converter={StaticResource ArabicEnumConverter}}"
                                                Width="150" />
                            <DataGridTextColumn Header="المبلغ"
                                                Binding="{Binding Amount, StringFormat={}{0:N2}}"
                                                Width="130" />
                            <DataGridTextColumn Header="طريقة الدفع"
                                                Binding="{Binding PaymentMethod, Converter={StaticResource ArabicEnumConverter}}"
                                                Width="150" />
                            <DataGridTextColumn Header="الرصيد بعد الحركة"
                                                Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}"
                                                Width="160" />
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <views:PaginationBar Grid.Row="1" Margin="0,8,0,0"
                                         Summary="{Binding LedgerPager.Summary}"
                                         HasPreviousPage="{Binding LedgerPager.HasPreviousPage}"
                                         HasNextPage="{Binding LedgerPager.HasNextPage}"
                                         RefreshCommand="{Binding LedgerPager.RefreshCommand}"
                                         PreviousCommand="{Binding LedgerPager.PreviousPageCommand}"
                                         NextCommand="{Binding LedgerPager.NextPageCommand}" />
                </Grid>
            </TabItem>
            <TabItem Header="فواتير المورد">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding PurchaseInvoices}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              SelectionMode="Single" MinHeight="0" RowHeight="44"
                              ColumnHeaderHeight="42" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="150" />
                            <DataGridTextColumn Header="التاريخ"
                                                Binding="{Binding CreatedAt, Converter={StaticResource EgyptDateTimeConverter}}"
                                                Width="180" />
                            <DataGridTextColumn Header="الإجمالي"
                                                Binding="{Binding GrandTotal, StringFormat={}{0:N2}}"
                                                Width="150" />
                            <DataGridTextColumn Header="المدفوع"
                                                Binding="{Binding TotalPaid, StringFormat={}{0:N2}}"
                                                Width="150" />
                            <DataGridTemplateColumn Header="الإجراء" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="عرض الفاتورة" Padding="8,4"
                                                Click="ShowPurchaseInvoice_OnClick" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="1" Margin="2,8,2,0">
                        <TextBlock Text="{Binding PurchaseInvoicePager.Summary}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleBrush}" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="السابق"
                                    Command="{Binding PurchaseInvoicePager.PreviousPageCommand}" />
                            <Button Content="التالي"
                                    Command="{Binding PurchaseInvoicePager.NextPageCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
