<ui:FluentWindow x:Class="Cashier.UI.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xml:lang="ar-EG"
                 Title="نظام نقاط البيع - تسجيل الدخول" Height="620" Width="960"
                 FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource CardBackgroundBrush}" Padding="48">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="نظام نقاط البيع" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="إدارة مبيعاتك&#10;بسهولة وأمان" Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="38" FontWeight="Bold" Margin="0,28,0,12" TextWrapping="Wrap" />
                <TextBlock Text="منصة متكاملة لإدارة المتجر والمخزون والفواتير."
                           Foreground="{DynamicResource SubtleBrush}" FontSize="16" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Margin="32,38" Padding="28" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="18">
            <StackPanel Width="340" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Margin="0,0,0,18">
                    <TextBlock Text="م" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="مرحباً بك" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="سجل الدخول للمتابعة." Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,24" />
                <TextBlock Text="اسم المستخدم" Margin="3,6,3,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="كلمة المرور" Margin="3,6,3,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordBox" Grid.Column="0" Margin="3" Padding="10,8" MinHeight="36"
                                 PasswordChanged="PasswordBox_OnPasswordChanged"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBox x:Name="VisiblePasswordBox" Grid.Column="0" Margin="3" Padding="10,8" MinHeight="36"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Grid.Column="1" Content="إظهار"
                            Click="TogglePasswordVisibility_OnClick"
                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            VerticalAlignment="Center" MinWidth="64" Padding="10,7" Margin="3"
                            ToolTip="إظهار كلمة المرور" />
                    <Button Grid.Column="1" Content="إخفاء"
                            Click="TogglePasswordVisibility_OnClick"
                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            VerticalAlignment="Center" MinWidth="64" Padding="10,7" Margin="3"
                            ToolTip="إخفاء كلمة المرور" />
                </Grid>
                <Button Content="تسجيل الدخول" Command="{Binding LoginCommand}"
                        Background="{DynamicResource AccentBrush}" Foreground="White" Margin="3,14,3,0" />
                <TextBlock Text="{Binding CurrentVersion, StringFormat=الإصدار الحالي: {0}}"
                           Foreground="{DynamicResource SubtleBrush}" Margin="4,10,4,0" />
                <TextBlock Margin="4,2,4,0">
                    <Hyperlink Command="{Binding CheckForUpdatesCommand}"
                               Foreground="{DynamicResource AccentBrush}">
                        التحقق من التحديثات وتثبيت أحدث إصدار
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AlertBrush}" TextWrapping="Wrap" Margin="3,12,3,0" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
