<UserControl x:Class="Cashier.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cashier.UI.Controls"
             xmlns:views="clr-namespace:Cashier.UI.Views">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="18" Margin="0,0,0,14" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="إدارة المنتجات" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="اختر منتجاً من الجدول لعرض بياناته." Foreground="{StaticResource SubtleBrush}" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="بحث بالاسم أو الرمز أو الباركود" VerticalAlignment="Center" Margin="4" />
                        <TextBox Width="330" Padding="10,6" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="ابحث بالاسم أو الرمز أو الباركود">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="بحث" Command="{Binding SearchCommand}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="إضافة منتج" Command="{Binding NewProductCommand}" Background="{DynamicResource AccentBrush}" Foreground="White" />
                    <Button Content="تعديل" Command="{Binding EditCommand}" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBooleanConverter}}" />
                    <Button Content="حذف" Command="{Binding DeactivateCommand}" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBooleanConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="ProductsGrid" Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                              RowHeaderWidth="44" LoadingRow="ProductsGrid_OnLoadingRow" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding SellingPrice, StringFormat={}{0:N2}}" Width="110" />
                            <DataGridTextColumn Header="كمية المحل" Binding="{Binding CurrentStock, StringFormat={}{0:0.###}}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <views:PaginationBar Grid.Row="1" Margin="0,7,0,0"
                                         Summary="{Binding Pager.Summary}" HasPreviousPage="{Binding Pager.HasPreviousPage}"
                                         HasNextPage="{Binding Pager.HasNextPage}" RefreshCommand="{Binding Pager.RefreshCommand}"
                                         PreviousCommand="{Binding Pager.PreviousPageCommand}" NextCommand="{Binding Pager.NextPageCommand}" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="18" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12"
                    Visibility="{Binding HasSelectedProduct, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Visible" controls:ScrollNavigation.IsEnabled="True">
                    <StackPanel>
                        <Border Height="210" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" ClipToBounds="True">
                            <Image Source="{Binding Selected.ImagePath, Converter={StaticResource ProductImageSourceConverter}}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding Selected.Name, TargetNullValue=مرر المؤشر على منتج لعرض التفاصيل}" FontSize="22" FontWeight="SemiBold" Margin="2,14,2,4" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selected.Description, TargetNullValue=لا يوجد وصف}" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="2,0,2,10" />
                        <Separator Margin="0,4" />
                        <Grid Margin="2,8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="الباركود" Foreground="{StaticResource SubtleBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.Barcode, TargetNullValue=—}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="رمز المنتج" Foreground="{StaticResource SubtleBrush}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Sku}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="2" Text="الفئة" Foreground="{StaticResource SubtleBrush}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Category.Name, TargetNullValue=—}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="3" Text="العلامة التجارية" Foreground="{StaticResource SubtleBrush}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.Brand.Name, TargetNullValue=—}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="4" Text="سعر البيع" Foreground="{StaticResource SubtleBrush}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.SellingPrice, StringFormat={}{0:N2}}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="5" Text="سعر التكلفة" Foreground="{StaticResource SubtleBrush}" Margin="0,9,0,0"
                                                       Visibility="{Binding DataContext.CanManagePrices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Selected.CostPrice, StringFormat={}{0:N2}}" Margin="0,9,0,0"
                                       Visibility="{Binding DataContext.CanManagePrices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Row="6" Text="كمية المحل" Foreground="{StaticResource SubtleBrush}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Selected.CurrentStock, StringFormat={}{0:0.###}}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="7" Text="الوحدة" Foreground="{StaticResource SubtleBrush}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Selected.Unit, Converter={StaticResource ArabicEnumConverter}}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="8" Text="حد تنبيه كمية المحل" Foreground="{StaticResource SubtleBrush}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Selected.MinStockAlert, StringFormat={}{0:0.###}}" Margin="0,9,0,0" />
                        </Grid>
                        <CheckBox Content="المنتج مفعل" IsChecked="{Binding Selected.IsActive}" IsEnabled="False" Margin="2,8" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <TextBlock Grid.Column="1" Text="اختر منتجاً من الجدول لعرض التفاصيل."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}"
                       Visibility="{Binding HasSelectedProduct, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Grid>
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AlertBrush}" />
        </Border>
    </Grid>
</UserControl>
