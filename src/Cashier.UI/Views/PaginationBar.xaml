<UserControl x:Class="Cashier.UI.Views.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Border Padding="8,5" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
        <DockPanel>
            <Button Content="تحديث" Command="{Binding RefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="التالي" Command="{Binding NextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding HasNextPage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Text="{Binding Summary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource SubtleBrush}" />
                <Button Content="السابق" Command="{Binding PreviousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding HasPreviousPage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
