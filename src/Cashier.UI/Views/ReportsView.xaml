<UserControl x:Class="Cashier.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="ReportsView_OnLoaded">
    <Grid Margin="22" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="التقارير والتحليلات" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="ملخص المبيعات والأرباح والإيرادات وأرصدة العملاء والموردين"
                               Foreground="{DynamicResource SubtleBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="4">
                        <TextBlock Text="من تاريخ" Foreground="{DynamicResource SubtleBrush}" />
                        <DatePicker SelectedDate="{Binding FromDate}" Width="155" />
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="إلى تاريخ" Foreground="{DynamicResource SubtleBrush}" />
                        <DatePicker SelectedDate="{Binding ToDate}" Width="155" />
                    </StackPanel>
                    <Button Content="تحديث التقارير" Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                            Background="{DynamicResource AccentBrush}" Foreground="White" VerticalAlignment="Bottom" />
                </StackPanel>
            </Grid>
        </Border>
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
            <Border Margin="0,0,5,0" Padding="12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="11">
                <StackPanel>
                    <TextBlock Text="إجمالي المبيعات" Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding PeriodSalesTotal, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
            <Border Margin="5,0" Padding="12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="11">
                <StackPanel>
                    <TextBlock Text="إجمالي الأرباح" Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding PeriodProfitTotal, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Margin="5,0" Padding="12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="11">
                <StackPanel>
                    <TextBlock Text="الإيرادات المحصلة" Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding PeriodRevenueTotal, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Margin="5,0" Padding="12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="11">
                <StackPanel>
                    <TextBlock Text="أرصدة العملاء الحالية" Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding CustomerBalanceTotal, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Margin="5,0,0,0" Padding="12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="11">
                <StackPanel>
                    <TextBlock Text="مستحقات الموردين الحالية" Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding SupplierBalanceTotal, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>
        <TabControl Grid.Row="2">
            <TabItem Header="العمل اليومي">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="تصدير تقرير العمل اليومي CSV" Command="{Binding ExportDailyCommand}"
                            IsEnabled="{Binding CanExportDaily}" HorizontalAlignment="Left" Margin="2,2,2,8" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MinHeight="0" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}" Width="*" />
                            <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding InvoiceCount, StringFormat={}{0:N0}}" Width="150" />
                            <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding SalesTotal, StringFormat={}{0:N2}}" Width="180" />
                            <DataGridTextColumn Header="نقدي" Binding="{Binding CashReceived, StringFormat={}{0:N2}}" Width="160" />
                            <DataGridTextColumn Header="بطاقة" Binding="{Binding CardReceived, StringFormat={}{0:N2}}" Width="160" />
                            <DataGridTextColumn Header="آجل للعملاء" Binding="{Binding CustomerBalance, StringFormat={}{0:N2}}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="الأرباح">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="تصدير تقرير الأرباح CSV" Command="{Binding ExportProfitCommand}"
                            IsEnabled="{Binding CanExportProfit}" HorizontalAlignment="Left" Margin="2,2,2,8" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MinHeight="0" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}" Width="*" />
                            <DataGridTextColumn Header="قيمة المبيعات" Binding="{Binding SalesTotal, StringFormat={}{0:N2}}" Width="220" />
                            <DataGridTextColumn Header="تكلفة البضاعة المباعة" Binding="{Binding CostTotal, StringFormat={}{0:N2}}" Width="240" />
                            <DataGridTextColumn Header="الربح الإجمالي" Binding="{Binding ProfitTotal, StringFormat={}{0:N2}}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="الإيرادات">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="تصدير تقرير الإيرادات CSV" Command="{Binding ExportRevenueCommand}"
                            IsEnabled="{Binding CanExportRevenue}" HorizontalAlignment="Left" Margin="2,2,2,8" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RevenueRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MinHeight="0" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}" Width="*" />
                            <DataGridTextColumn Header="إيراد نقدي" Binding="{Binding CashReceived, StringFormat={}{0:N2}}" Width="200" />
                            <DataGridTextColumn Header="إيراد البطاقات" Binding="{Binding CardReceived, StringFormat={}{0:N2}}" Width="210" />
                            <DataGridTextColumn Header="إجمالي الإيرادات المحصلة" Binding="{Binding TotalReceived, StringFormat={}{0:N2}}" Width="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="أرصدة العملاء">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="تصدير تقرير العملاء CSV" Command="{Binding ExportCustomersCommand}"
                            IsEnabled="{Binding CanExportCustomers}" HorizontalAlignment="Left" Margin="2,2,2,8" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CustomerRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MinHeight="0" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="كود العميل" Binding="{Binding CustomerCode}" Width="130" />
                            <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="150" />
                            <DataGridTextColumn Header="الرصيد الحالي" Binding="{Binding CurrentBalance, StringFormat={}{0:N2}}" Width="150" />
                            <DataGridTextColumn Header="مبيعات آجلة خلال الفترة" Binding="{Binding PeriodCharges, StringFormat={}{0:N2}}" Width="190" />
                            <DataGridTextColumn Header="مدفوعات خلال الفترة" Binding="{Binding PeriodPayments, StringFormat={}{0:N2}}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="مستحقات الموردين">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="تصدير تقرير الموردين CSV" Command="{Binding ExportSuppliersCommand}"
                            IsEnabled="{Binding CanExportSuppliers}" HorizontalAlignment="Left" Margin="2,2,2,8" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SupplierRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MinHeight="0" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم المورد" Binding="{Binding SupplierName}" Width="*" />
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="170" />
                            <DataGridTextColumn Header="الرصيد الحالي" Binding="{Binding CurrentBalance, StringFormat={}{0:N2}}" Width="170" />
                            <DataGridTextColumn Header="مستحقات خلال الفترة" Binding="{Binding PeriodCharges, StringFormat={}{0:N2}}" Width="200" />
                            <DataGridTextColumn Header="مدفوعات خلال الفترة" Binding="{Binding PeriodPayments, StringFormat={}{0:N2}}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{DynamicResource AlertBrush}"
                   Margin="4,10" TextWrapping="Wrap" />
    </Grid>
</UserControl>
