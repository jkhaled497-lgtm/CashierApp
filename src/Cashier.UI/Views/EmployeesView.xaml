<UserControl x:Class="Cashier.UI.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Cashier.UI.Views">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="16" Margin="0,0,0,12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="إضافة موظف" Command="{Binding NewEmployeeCommand}" Background="{DynamicResource AccentBrush}" Foreground="White" />
                    <Button Content="تعديل بيانات الموظف" Command="{Binding EditCommand}" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBooleanConverter}}" />
                    <Button Content="حذف" Command="{Binding DeactivateCommand}" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBooleanConverter}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="إدارة الموظفين" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="البيانات الوظيفية ومعلومات التواصل والرواتب" Foreground="{StaticResource SubtleBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم الموظف" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="رقم الهوية" Binding="{Binding NationalId}" Width="150" />
                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="140" />
                <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="180" />
                <DataGridTextColumn Header="المسمى الوظيفي" Binding="{Binding JobTitle}" Width="130" />
                <DataGridTextColumn Header="تاريخ التوظيف" Binding="{Binding HireDate}" Width="110" />
                <DataGridTextColumn Header="الراتب" Binding="{Binding BasicSalary}" Width="100" />
                <DataGridCheckBoxColumn Header="مفعل" Binding="{Binding IsActive}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
        <views:PaginationBar Grid.Row="2" Margin="0,8,0,0"
                            Summary="{Binding Pager.Summary}" HasPreviousPage="{Binding Pager.HasPreviousPage}"
                            HasNextPage="{Binding Pager.HasNextPage}" RefreshCommand="{Binding Pager.RefreshCommand}"
                            PreviousCommand="{Binding Pager.PreviousPageCommand}" NextCommand="{Binding Pager.NextPageCommand}" />
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AlertBrush}" />
        </Border>
    </Grid>
</UserControl>
