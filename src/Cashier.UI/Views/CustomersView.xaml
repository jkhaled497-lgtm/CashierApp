<UserControl x:Class="Cashier.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Cashier.UI.Views">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="إدارة العملاء" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="ملفات العملاء والأرصدة وكشوف الحسابات" Foreground="{StaticResource SubtleBrush}" Margin="0,3,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="بحث باسم العميل" VerticalAlignment="Center" Margin="4" />
                        <TextBox Width="310" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ابحث باسم العميل" />
                        <Button Content="بحث" Command="{Binding LoadCommand}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="إضافة عميل" Command="{Binding NewCustomerCommand}" Background="{DynamicResource AccentBrush}" Foreground="White" />
                    <Button Content="تعديل البيانات" Command="{Binding EditCommand}" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBooleanConverter}}" />
                    <Button Content="إيقاف العميل" Command="{Binding DeactivateCommand}" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBooleanConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
            <Border Margin="0,0,6,0" Padding="14" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                <StackPanel><TextBlock Text="إجمالي العملاء" Foreground="{StaticResource SubtleBrush}" /><TextBlock Text="{Binding CustomerCount, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
            </Border>
            <Border Margin="6,0" Padding="14" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                <StackPanel><TextBlock Text="عملاء عليهم رصيد (الصفحة)" Foreground="{StaticResource SubtleBrush}" /><TextBlock Text="{Binding CustomersWithBalanceCount, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Margin="6,0,0,0" Padding="14" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                <StackPanel><TextBlock Text="إجمالي أرصدة الصفحة" Foreground="{StaticResource SubtleBrush}" /><TextBlock Text="{Binding CurrentPageBalanceTotal, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" /></StackPanel>
            </Border>
        </UniformGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.3*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              MinHeight="0" RowHeight="42" ColumnHeaderHeight="38" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم العميل" Binding="{Binding FullName}" Width="*" />
                            <DataGridTextColumn Header="الرصيد" Binding="{Binding CurrentBalance, StringFormat={}{0:N2}}" Width="76" />
                            <DataGridTemplateColumn Header="" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="عرض" Padding="4,3" Margin="1"
                                                Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <views:PaginationBar Grid.Row="1" Margin="0,7,0,0"
                                         Summary="{Binding Pager.Summary}" HasPreviousPage="{Binding Pager.HasPreviousPage}"
                                         HasNextPage="{Binding Pager.HasNextPage}" RefreshCommand="{Binding Pager.RefreshCommand}"
                                         PreviousCommand="{Binding Pager.PreviousPageCommand}" NextCommand="{Binding Pager.NextPageCommand}" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12"
                    Visibility="{Binding IsDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.FullName, TargetNullValue=اختر عميلاً لعرض التفاصيل}" FontSize="19" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                            <TextBlock Text="الرصيد المستحق" Foreground="{StaticResource SubtleBrush}" />
                            <TextBlock Text="{Binding Selected.CurrentBalance, StringFormat={}{0:N2}}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,10,0,8" Padding="10" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                            Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="تسجيل دفعة رصيد" FontWeight="SemiBold" Margin="2,0,2,4" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="طريقة الدفع" Style="{StaticResource EditorFieldLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="المبلغ" Style="{StaticResource EditorFieldLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="ملاحظات" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding BalancePaymentMethod}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          MaxDropDownHeight="220">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ArabicEnumConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BalancePaymentAmount, UpdateSourceTrigger=PropertyChanged}" ToolTip="قيمة الدفعة" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding BalancePaymentNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="ملاحظات (اختياري)" />
                                <Button Grid.Row="1" Grid.Column="3" Content="إضافة استحقاق" Command="{Binding AddBalanceChargeCommand}"
                                        Margin="3,0" />
                                <Button Grid.Row="1" Grid.Column="4" Content="سداد الاستحقاق" Command="{Binding RecordPaymentCommand}"
                                        Background="{DynamicResource AccentBrush}" Foreground="White" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="18"
                            Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="افتح كشف الحساب في صفحة مستقلة"
                                       Foreground="{DynamicResource SubtleBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <Button Content="فتح كشف حساب العميل"
                                    Click="OpenCustomerStatement_OnClick"
                                    IsEnabled="{Binding HasSelectedCustomer}"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Column="1" Text="اختر عميلاً ثم اضغط «عرض» لمشاهدة كشف الحساب."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}"
                       Visibility="{Binding IsDetailsVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Grid>
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AlertBrush}" />
        </Border>
    </Grid>
</UserControl>
